# ============================================================
# TRINITY.AI — Variáveis de ambiente (monorepo raiz)
# ============================================================
# Este arquivo documenta TODAS as variáveis usadas por todos os
# packages. Cada package também tem seu próprio .env.example.
#
# INSTRUÇÕES:
#   1. Copie e ajuste por package: cp packages/core/.env.example packages/core/.env
#   2. NUNCA commite arquivos .env
#   3. NUNCA compartilhe chaves de API
# ============================================================

# ════════════════════════════════════════════════════════════
# TRINITY CORE (packages/core/)
# ════════════════════════════════════════════════════════════

# ── Aplicação ───────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Banco de Dados ──────────────────────────────────────────
# Desenvolvimento:
DATABASE_URL=sqlite:///./trinity_dev.db
# Produção — PostgreSQL OBRIGATÓRIO (SQLite não suporta escrita concorrente):
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/trinity_db

# ── Connection Pool (PostgreSQL) — ignorado para SQLite ──────
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ── JWT ──────────────────────────────────────────────────────
# OBRIGATÓRIO em produção — gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=MUDE-ISSO-EM-PRODUCAO-gere-um-segredo-real
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ── Provedores de IA ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...   # obrigatório
OPENAI_API_KEY=sk-...                # opcional (failover)
GEMINI_API_KEY=                      # opcional (failover)

# ── CORS ─────────────────────────────────────────────────────
# Produção: NUNCA incluir localhost. Formato JSON.
# ALLOWED_ORIGINS=["https://app.trinity.ai"]

# ════════════════════════════════════════════════════════════
# TRINITY WEB (packages/web/)
# ════════════════════════════════════════════════════════════

# URL da API do Core (sem trailing slash):
NEXT_PUBLIC_API_URL=http://localhost:8000
# Em produção:
# NEXT_PUBLIC_API_URL=https://api.trinity.ai

# ════════════════════════════════════════════════════════════
# OBSERVAÇÕES DE SEGURANÇA (produção)
# ════════════════════════════════════════════════════════════
#
# O Core recusará iniciar com ENVIRONMENT=production se:
#   - JWT_SECRET_KEY for um placeholder conhecido
#   - JWT_SECRET_KEY tiver menos de 32 caracteres
#   - ANTHROPIC_API_KEY estiver vazio
#   - DEBUG=true
#   - ALLOWED_ORIGINS incluir localhost ou 127.0.0.1
#
# Docker images obrigatórias para agent com shell/desktop:
#   docker build -t trinity-sandbox:latest packages/core/docker/sandbox/
#   docker build -t trinity-desktop-sandbox:latest packages/core/docker/desktop-sandbox/
