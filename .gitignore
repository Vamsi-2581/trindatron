# ============================================================
# TRINITY.AI — .gitignore
# Python | Node.js | Electron | Next.js | Windows | Cursor
# ============================================================

# ── Environment & Secrets ───────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.test
.env.staging
.env.production
*.pem
*.key
*.p12
*.cert

# Local-only secrets scratch directory — never committed, never pushed.
.secrets/

# Local-only API key material, kept beside the service that reads it.
# Needed as its own rule: the *.key pattern above only catches that one
# extension, so a key saved as .txt or with no extension would otherwise
# be committable.
packages/core/api_key/

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.pyo

# ── Databases (dev only) ────────────────────────────────────
*.db
*.sqlite
*.sqlite3
packages/core/trinity_dev.db
packages/core/trinity_test.db

# ── Node.js ─────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.pnp.*

# ── Next.js ─────────────────────────────────────────────────
.next/
out/
.vercel

# ── TypeScript ──────────────────────────────────────────────
*.tsbuildinfo

# ── Electron ────────────────────────────────────────────────
packages/desktop/dist/
packages/desktop/release/
packages/desktop/out/
packages/desktop/.webpack/
packages/desktop/app/dist/

# ── Build artifacts ─────────────────────────────────────────
dist/
build/
*.exe
*.msi

# ── Logs ────────────────────────────────────────────────────
logs/
*.log
lerna-debug.log*

# ── TRINITY AGENT workspace (gerado em runtime) ─────────────
packages/core/workspace/*
!packages/core/workspace/.gitkeep

# ── OS — Windows ────────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# ── OS — macOS ──────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ── Claude Code (memory, session data) ─────────────────────
.claude/

# ── Graphify (regenerable knowledge graph output + cache) ───
graphify-out/

# ── IDE — Cursor ────────────────────────────────────────────
.cursor/

# ── IDE — VS Code (manter apenas extensions.json) ───────────
.vscode/*
!.vscode/extensions.json

# ── IDE — JetBrains ─────────────────────────────────────────
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Documentação gerada ─────────────────────────────────────
docs/api/generated/

# ── Local-only material that must never be published ────────
API-KEYS_TEXT.txt
*.db.backup-*
**/certs/
infra/modal/.env
.mcp.json
skills-lock.json
