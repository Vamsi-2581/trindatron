# ============================================================
# TRINITY CORE — Variáveis de ambiente
# ============================================================
# INSTRUÇÕES:
#   1. Copie: cp .env.example .env
#   2. Preencha com seus valores reais
#   3. NUNCA commite o arquivo .env
#   4. NUNCA compartilhe chaves de API
# ============================================================

# ── Aplicação ───────────────────────────────────────────────
ENVIRONMENT=development   # "development" | "production"
DEBUG=true                # false em produção (oculta /docs, desativa echo SQL)

# ── Banco de Dados ──────────────────────────────────────────
# Desenvolvimento — SQLite local, sem configuração adicional:
DATABASE_URL=sqlite:///./trinity_dev.db

# Produção — PostgreSQL OBRIGATÓRIO (SQLite não suporta escrita concorrente).
# TRINITY CORE usa psycopg3 (psycopg[binary]). Esquema canônico:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/trinity_db

# ── Connection Pool (PostgreSQL) ─────────────────────────────
# Ignorado para SQLite.
DB_POOL_SIZE=5          # conexões ativas mantidas no pool
DB_MAX_OVERFLOW=10      # conexões extras permitidas acima do pool_size
DB_POOL_TIMEOUT=30      # segundos para aguardar conexão disponível
DB_POOL_RECYCLE=1800    # reciclar conexões mais velhas que este tempo (seg)

# ── Autenticação JWT ─────────────────────────────────────────
# OBRIGATÓRIO em produção. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Em produção: mínimo 32 chars, não pode ser este placeholder.
JWT_SECRET_KEY=MUDE-ISSO-EM-PRODUCAO-gere-um-segredo-real
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ── Provedores de IA ─────────────────────────────────────────
# OBRIGATÓRIO em produção — sem isso chat e agente falham.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Opcionais — usados como failover pelo Model Router:
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
GROQ_API_KEY=   # ultra-cheap CHAT routing (groq-llama-8b); sem chave, fallback automático
# Plano da organização Groq: "free" (cobra US$ 0 dentro dos limites) ou "developer" (paga por token).
# Muda só o custo real registrado (usage_records.provider_cost_usd); o TCU continua no preço de tabela.
# A conta atual é Free: use free. Sem a variável, o padrão "developer" registra preço de tabela (nunca subestima).
GROQ_BILLING_TIER=free

# ── Voz (STT/TTS) ────────────────────────────────────────────
# Arquitetura adapter/provider, sem dependência rígida de um único vendor.
# TTS e STT têm seletores SEPARADOS: Gemini 2.5 Flash TTS é um modelo
# somente-síntese (não faz reconhecimento de fala), então não pode servir
# /voice/transcribe — daí o default de STT continuar em elevenlabs.
VOICE_PROVIDER=gemini          # provider de TTS — default econômico
VOICE_PROVIDER_STT=elevenlabs  # provider de STT — único que transcreve hoje

# ElevenLabs — provider alternativo/futuro para TTS, e provider padrão de
# STT. OBRIGATÓRIO para /voice/transcribe funcionar (default), e para
# /voice/synthesize se VOICE_PROVIDER=elevenlabs. Sem a chave, as rotas
# retornam 424 com o nome exato da variável faltante — nunca inventamos.
ELEVENLABS_API_KEY=
# Voice ID padrão usado quando o request não especifica um. Obtenha em
# https://elevenlabs.io/app/voice-library (necessário só se ElevenLabs for
# usado para TTS).
ELEVENLABS_TTS_VOICE_ID=
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STT_MODEL_ID=scribe_v1

# Gemini TTS — reaproveita GEMINI_API_KEY acima (não duplicamos a chave).
# OBRIGATÓRIO (a chave) para /voice/synthesize funcionar com o default
# VOICE_PROVIDER=gemini. voice_name/model_id não são secrets — são
# identificadores públicos documentados pela Google, por isso têm default.
GEMINI_TTS_VOICE_NAME=Kore
GEMINI_TTS_MODEL_ID=gemini-2.5-flash-preview-tts

# ── CORS ─────────────────────────────────────────────────────
# Em produção: NUNCA incluir localhost. Formato JSON.
# ALLOWED_ORIGINS=["https://app.trinity.ai","https://trinity.ai"]
# Em desenvolvimento (default do código): localhost:3000 e localhost:3001

# ── Agent / Sandbox ──────────────────────────────────────────
# Docker images devem ser construídas antes de usar agent com shell/desktop.
# Veja: packages/core/docker/sandbox/Dockerfile
# Veja: packages/core/docker/desktop-sandbox/Dockerfile
AGENT_WORKSPACE_ROOT=workspace/sessions
AGENT_MAX_ITERATIONS=10
AGENT_SANDBOX_IMAGE=trinity-sandbox:latest
AGENT_SANDBOX_MEMORY_LIMIT=256m
AGENT_SANDBOX_CPU_LIMIT=0.5
AGENT_SANDBOX_PIDS_LIMIT=64
AGENT_DESKTOP_SANDBOX_IMAGE=trinity-desktop-sandbox:latest
AGENT_DESKTOP_SANDBOX_MEMORY_LIMIT=512m
AGENT_DESKTOP_SANDBOX_CPU_LIMIT=1.0
AGENT_DESKTOP_SANDBOX_PIDS_LIMIT=128

# Security Hardening — CodeWorkspace.root_path (POST/PATCH /workspaces/code)
# lets a caller point a workspace's file browser/execute commands at ANY
# host directory, with no concept of per-user ownership. Safe only for a
# single-user local/desktop deployment. NUNCA habilite isso na SaaS
# hospedada multi-tenant — qualquer usuário autenticado poderia navegar/ler
# qualquer arquivo que o processo do servidor conseguir ler (.env, outros
# projetos, credenciais). Default false em todo lugar.
CODE_WORKSPACE_ARBITRARY_ROOT_ENABLED=false

# ── Billing — Binance Pay (SANDBOX/TESTE apenas) ────────────────
# Binance Pay não tem ambiente de sandbox público documentado — o único
# endpoint documentado é o de produção (https://bpay.binanceapi.com), usado
# hoje por merchants reais. Por isso este provider NUNCA é registrado a
# menos que BINANCE_PAY_ENABLED=true E as duas credenciais abaixo estejam
# preenchidas — deixe tudo como está (false/vazio) em qualquer ambiente que
# não seja um teste manual e consciente com credenciais reais de merchant.
# NUNCA preencha estes valores neste arquivo .env.example nem os commite
# em .env — são apenas placeholders.
BINANCE_PAY_ENABLED=false
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=
BINANCE_PAY_BASE_URL=https://bpay.binanceapi.com
# Chave pública RSA (PEM) da Binance para verificar assinatura de webhook.
# Opcional — se vazio, o adapter busca e cacheia via Query Certificate API
# na primeira chamada.
BINANCE_PAY_PUBLIC_KEY_PEM=
# Janela de tolerância (segundos) para o timestamp do webhook — primeira
# camada de defesa contra replay de um payload capturado. A segunda camada
# (rastreamento de nonce, banco de dados, multi-processo) é automática e
# não exige nenhuma variável de ambiente — ver webhook_nonce_retention_seconds
# abaixo apenas se quiser ajustar por quanto tempo um nonce fica retido.
BINANCE_PAY_WEBHOOK_MAX_CLOCK_SKEW_SECONDS=300
# Retenção (segundos) de cada nonce de webhook já processado — deve ser um
# pouco maior que BINANCE_PAY_WEBHOOK_MAX_CLOCK_SKEW_SECONDS acima (um
# webhook mais velho que a janela de clock-skew já é rejeitado antes de
# chegar na checagem de nonce). Raramente precisa ser alterado.
WEBHOOK_NONCE_RETENTION_SECONDS=3600

# TTL (segundos) para reclamar uma reserva de TCU 'pending' órfã (processo
# crashou antes do finally rodar) — ver entitlement_service.py's
# reclaim_expired_reservations(). Raramente precisa ser alterado.
TCU_RESERVATION_TTL_SECONDS=1800

# ── Billing — NOWPayments (primeiro provider cripto ATIVO) ──────
# Este é o provider planejado para o primeiro lançamento cripto real.
# NUNCA registrado a menos que NOWPAYMENTS_ENABLED=true E as duas
# credenciais abaixo estejam preenchidas — deixe tudo como está
# (false/vazio) em qualquer ambiente que não seja um teste manual e
# consciente com credenciais reais de merchant.
# NUNCA preencha estes valores neste arquivo .env.example nem os commite
# em .env — são apenas placeholders.
NOWPAYMENTS_ENABLED=false
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io
# Opcionais — URL pública (HTTPS, produção real) para onde a NOWPayments
# deve enviar o IPN, e para onde a invoice hospedada redireciona o
# cliente após o pagamento. NÃO inventar valores aqui — só preencher
# após um deploy real existir (ver docs/NOWPAYMENTS_INTEGRATION.md).
NOWPAYMENTS_IPN_CALLBACK_URL=
NOWPAYMENTS_SUCCESS_URL=
NOWPAYMENTS_CANCEL_URL=

# ── Billing — Mercado Pago (primeiro provider FIAT — Checkout Pro) ──
# Adapter hospedado (preference/redirect) — nenhum dado de cartão chega ao
# TRINITY Core; PCI fica inteiramente do lado do Mercado Pago. NUNCA
# registrado a menos que MERCADOPAGO_ENABLED=true E as duas credenciais
# abaixo estejam preenchidas — deixe tudo como está (false/vazio) em
# qualquer ambiente que não seja um teste manual e consciente com
# credenciais reais de merchant.
# NUNCA preencha estes valores neste arquivo .env.example nem os commite
# em .env — são apenas placeholders.
MERCADOPAGO_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_BASE_URL=https://api.mercadopago.com
# Opcionais — URL pública (HTTPS, produção real) para onde o Mercado Pago
# deve enviar a notificação de webhook, e para onde o Checkout Pro
# redireciona o pagador após sucesso/pendência/falha. NÃO inventar valores
# aqui — só preencher após um deploy real existir.
MERCADOPAGO_NOTIFICATION_URL=
MERCADOPAGO_SUCCESS_URL=
MERCADOPAGO_PENDING_URL=
MERCADOPAGO_FAILURE_URL=

# ── Billing — Stripe (segundo provider FIAT — Stripe Checkout) ─────
# Adapter hospedado (Checkout Session/redirect) — nenhum dado de cartão
# chega ao TRINITY Core; PCI fica inteiramente do lado da Stripe. NUNCA
# registrado a menos que STRIPE_ENABLED=true E as duas credenciais abaixo
# estejam preenchidas — deixe tudo como está (false/vazio) em qualquer
# ambiente que não seja um teste manual e consciente com credenciais reais.
# NUNCA preencha estes valores neste arquivo .env.example nem os commite
# em .env — são apenas placeholders.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASE_URL=https://api.stripe.com
# success_url é OBRIGATÓRIO pela própria API da Stripe (Checkout Session)
# — sem ele, uma chamada real falha do lado da Stripe. NÃO inventar valor
# aqui — só preencher após um deploy real existir.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# ── Presentation capability ──────────────────────────────────────────────
# Presenton runs as its own Railway service on the private network and is
# never exposed publicly. An empty base URL simply means the capability is
# not available in this deployment — a normal state, not a failure.
# See infra/presenton/README.md for the full service configuration.
PRESENTON_BASE_URL=
# Preferred credential: a key the engine mints and can revoke on its own.
# Username/password remain for a fresh engine that has not minted one yet.
PRESENTON_API_KEY=
PRESENTON_USERNAME=
PRESENTON_PASSWORD=
# Shared token between core and the engine. The engine holds this INSTEAD of
# the Gemini key: it is pointed at core's own gateway, so Google's credential
# never leaves this side. Same value on both services.
PRESENTON_LLM_GATEWAY_TOKEN=
PRESENTON_LLM_BASE_URL=
# Stock photography for slides. Not an LLM — an image search — so it does not
# affect the Gemini-only rule for the intelligence in this capability.
PEXELS_API_KEY=

# ── Object storage (Cloudflare R2) ───────────────────────────────────────
# Generated files (PPTX/PDF) never go in Postgres. Leaving these empty
# selects the local-directory store, which works for development but cannot
# mint signed URLs and does not survive a redeploy.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Higgsfield (media, server-side only) — one more hosted route in the media
# orchestrator (docs/MEDIA_ENGINES.md §10). Empty = every Higgsfield route is
# unavailable. Format: <key id>:<key secret> (from open.higgsfield.ai/api-keys).
# Never in Mobile, code, tests, logs or Git.
HIGGSFIELD_API_KEY=
# Routes run only after the operator accepts the API terms:
# MEDIA_ACCEPTED_LICENSE_CONDITIONS=higgsfield_api_terms
# MEDIA_IMAGE_ROUTES=soul_2@higgsfield,...   MEDIA_VIDEO_ROUTES=kling_3_std@higgsfield,...

# Experimental local capabilities (docs/LOCAL_AI_LAB.md). All OFF by default; each needs its switch
# AND a loopback runtime / extractor. None is chosen by the Model Router or the STT fallback on its own.
# LOCAL_LLM_ENABLED=false
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8181/v1
# LOCAL_LLM_MODEL=
# STT_LOCAL_ENABLED=false
# WHISPER_LOCAL_BASE_URL=http://127.0.0.1:8282
# WEB_RESEARCH_ENABLED=false
# WEB_RESEARCH_CRAWL4AI_PYTHON=
# WEB_RESEARCH_ALLOWED_DOMAINS=
# WEB_RESEARCH_BLOCKED_DOMAINS=
# groq.oss_120b (CP10-CP12, docs/LOCAL_AI_LAB.md) — FREE CORE CANDIDATE, dev/test only.
# Reuses GROQ_API_KEY above (no new credential). The Model Router cannot reach this
# candidate regardless of this flag — see trinity_router.lab.LAB_CATALOG and
# src/local_runtime/groq_candidate.py.
# GROQ_OSS_120B_ENABLED=false

# ── Account security (password recovery, email confirmation, lockout) ─────────
# Transactional email via Resend (https://resend.com). Empty key: no email is
# sent and every flow still answers the same way. EMAIL_FROM must be on a
# domain verified in Resend. Links point at WEB_APP_URL (or the first
# ALLOWED_ORIGINS entry), e.g. https://trindatron.com/auth/reset#token=...
RESEND_API_KEY=
# EMAIL_FROM=TRINDATRON <nao-responda@trindatron.com>
# PASSWORD_RESET_MINUTES=30
# EMAIL_VERIFY_HOURS=48
# AUTH_LOCKOUT_THRESHOLD=10
# AUTH_LOCKOUT_WINDOW_MINUTES=15
# AUTH_LOCKOUT_MINUTES=15
