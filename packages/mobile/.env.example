# TRINDATRON MOBILE — the ONLY configuration the app knows.
#
# EXPO_PUBLIC_* values are inlined into the JavaScript bundle and are readable
# by anyone who installs the app. Never put a secret here: no provider keys,
# no database URLs, no JWT secrets. The app talks to TRINITY CORE's public API
# and authenticates with the user's own session token — nothing else.

# Public base URL of TRINITY CORE (no trailing slash).
#   Web / iOS simulator on the same machine: http://localhost:8000
#   Android emulator:                          http://10.0.2.2:8000
#   Physical device on the LAN:                http://<your-computer-LAN-IP>:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
