{
  "expo": {
    "name": "TRINDATRON",
    "slug": "trindatron",
    "scheme": "trindatron",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/brand/trindatron-icon-1024.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#07080a",
    "locales": {
      "pt": "./locales/pt.json",
      "en": "./locales/en.json",
      "es": "./locales/es.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trindatron.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.trindatron.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/trindatron-adaptive-foreground.png",
        "backgroundColor": "#07080a"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/brand/trindatron-icon-32.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O TRINDATRON acessa sua galeria apenas para enviar as imagens que você escolher.",
          "cameraPermission": "O TRINDATRON usa a câmera apenas quando você decide fotografar algo para enviar.",
          "microphonePermission": "O TRINDATRON usa o microfone apenas enquanto você grava uma mensagem de voz."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O TRINDATRON usa o microfone apenas enquanto você grava uma mensagem de voz.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/trindatron-symbol-hd.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#07080a"
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-localization",
      "./plugins/withoutDevMenuButton",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5b7c9373-9f6b-4575-b4d8-ba6685ea51c8"
      }
    },
    "owner": "trindatron.com",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5b7c9373-9f6b-4575-b4d8-ba6685ea51c8"
    }
  }
}
